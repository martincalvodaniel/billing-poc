{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:ensure-indexes": "bun run scripts/ensureIndexes.ts",
    "dev": "next dev",
    "format": "biome format --write",
    "knip": "knip",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "load-data:absences": "bun run scripts/absences/loadSampleAbsences.ts",
    "load-data:clients": "bun run scripts/clients/loadSampleClients.ts",
    "load-data:month": "bun run scripts/payments/loadRandomDataForMonth.ts",
    "load-data:year": "bun run scripts/payments/loadRandomDataForYear.ts",
    "migrate:absences:partOfDay": "bun run scripts/absences/migrateBackfillPartOfDay.ts",
    "start": "next start",
    "test": "bun test --preload ./test/setup.ts",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.6.23",
    "mongodb": "7.4.0",
    "next": "16.2.10",
    "pdf-lib": "1.17.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "swr": "2.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tailwindcss/postcss": "4.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "knip": "6.24.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  }
}
